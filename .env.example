# Database (Neon Postgres). For fully-offline dev, point this at a local Postgres
# (postgresql://<you>@localhost:5432/inturn) — the driver auto-switches (db/index.ts).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/role-selection
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/role-selection

# Dev-only auth bypass. Set DEV_AUTH_BYPASS=1 to skip Clerk entirely and sign in as a
# seeded persona via /dev/login (sets an HMAC-signed cookie keyed by DEV_AUTH_SECRET).
# MUST be unset/0 in production — it is gated off at every layer, but never ship it on.
DEV_AUTH_BYPASS=
DEV_AUTH_SECRET=any-long-random-string-for-local-cookie-signing

# AI assists (task clarity, intern unblocker, CV parse, project + sprint generation).
# Without it the manual flows work and the AI buttons show a graceful retry.
ANTHROPIC_API_KEY=sk-ant-...

# Email (Resend). Notifications + invites; falls back to console logging in dev if unset.
RESEND_API_KEY=re_...
EMAIL_FROM="Inturn <noreply@inturn-hub.com>"
EMAIL_REPLY_TO=hello@inturn-hub.com

# Vercel Blob (auto-created when you add a Blob store to the Vercel project)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Optional: pin the public host of your Blob store (e.g. <store>.public.blob.vercel-storage.com).
# When set, server actions only accept URLs from this exact host. When unset, any
# *.public.blob.vercel-storage.com host is accepted (dev fallback).
BLOB_PUBLIC_HOST=

# Weekly "Pulse" digest cron (app/api/cron/pulse). Bearer-secured; the route returns 503 in
# production if the secret is unset. PULSE_ENABLED gates whether the sweep actually sends.
CRON_SECRET=any-long-random-string
PULSE_ENABLED=

# Public base URL used by SEO files (sitemap.xml, robots.txt). Must be set in Vercel env vars
# for all 3 environments. Falls back to https://inturn-hub.com when unset.
NEXT_PUBLIC_BASE_URL=https://inturn-hub.com

# Optional observability — both env-gated; leave blank in local dev.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
